{
  "name": "vibe3d",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-bosl2.mjs",
    "predev": "node scripts/fetch-bosl2.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-bosl2.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && vite build",
    "build:skill": "node scripts/fetch-bosl2.mjs && node scripts/build-skill.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/fetch-bosl2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "eval": "vitest run -c vitest.eval.config.ts"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "idb-keyval": "^6.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
